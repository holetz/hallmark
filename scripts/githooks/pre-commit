#!/usr/bin/env bash
# pre-commit: refuse a commit whose staged content or author email leaks.
# Install: git config core.hooksPath scripts/githooks (see CONTRIBUTING.md).
# Needs the quenching plugin's `cq` on PATH and fails closed without it.
set -Eeuo pipefail
ROOT="$(git rev-parse --show-toplevel)"
if ! command -v cq >/dev/null 2>&1; then
  echo "pre-commit: 'cq' (quenching plugin) not on PATH; refusing. See CONTRIBUTING.md." >&2
  exit 1
fi
# Generic patterns only: there is no private denylist (retired on 2026-10-27; see CONTRIBUTING.md).
exec cq security leak --staged --generic-only --root "$ROOT"
