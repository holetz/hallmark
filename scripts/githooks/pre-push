#!/usr/bin/env bash
# pre-push: refuse a push whose commits (added lines, messages, author and committer emails) leak.
# Git passes the refs being pushed on stdin; `cq security leak --pre-push` reads them there.
# Needs the quenching plugin's `cq` on PATH and fails closed without it.
set -Eeuo pipefail
ROOT="$(git rev-parse --show-toplevel)"
if ! command -v cq >/dev/null 2>&1; then
  echo "pre-push: 'cq' (quenching plugin) not on PATH; refusing. See CONTRIBUTING.md." >&2
  exit 1
fi
# Generic patterns only: there is no private denylist (retired on 2026-10-27; see CONTRIBUTING.md).
exec cq security leak --pre-push --generic-only --remote "${1:-}" --root "$ROOT"
